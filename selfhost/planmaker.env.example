# PLANMAKER self-host 서버 설정 예시.
#
# 저장소 밖으로 복사해서 값을 채운다. 채운 파일은 절대 커밋하지 않는다.
#   sudo mkdir -p /etc/planmaker
#   sudo cp selfhost/planmaker.env.example /etc/planmaker/planmaker.env
#   sudo chmod 600 /etc/planmaker/planmaker.env
#
# 주석은 줄 맨 앞에만 쓴다(값 뒤에 붙이지 않는다).

# 서버가 듣는 주소. 팀원은 http://<서버 IP>:3000/studio 로 접속한다.
HOST=0.0.0.0
PORT=3000

# 접속 암구호 흐름(기존 그대로). OpenAI 키는 서버에만 있고 팀원은 암구호만 입력한다.
# OpenAI 키는 "AI로 지시 다듬기"에 계속 쓰인다. 비워 두면 암구호 대신 개인 키를 묻는 화면이 된다.
OPENAI_API_KEY=
PLANMAKER_ACCESS_CODE=

# 이미지 생성은 같은 서버의 로컬 어댑터로 보낸다.
IMAGE_PROVIDER=local
# 어댑터 생성 주소. 지금 Windows PC의 .env에 있는 LOCAL_IMAGE_API_URL과 같은 경로를 쓴다.
LOCAL_IMAGE_API_URL=http://127.0.0.1:8787/어댑터-생성-경로
# 어댑터 Bearer 인증 키.
LOCAL_IMAGE_API_KEY=

# 이미지 한 장을 기다리는 최대 시간(ms). 900000 = 15분.
# 앞에 nginx 등을 둘 때는 그 대기시간을 이 값보다 길게 둔다(예시 nginx: 20분).
LOCAL_IMAGE_TIMEOUT_MS=900000

# (선택) 어댑터에 실어 보내고 결과에 기록할 모델 이름. 비워 두면 보내지 않는다.
LOCAL_IMAGE_MODEL=
